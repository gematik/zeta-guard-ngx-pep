openssl_conf = openssl_init

[openssl_init]
providers = provider_sect
alg_section = alg_sect

[alg_sect]
# Both providers register EC/ECDSA; without a preference OpenSSL 4 may pick ossl_hsm for
# software keys, which then fail to sign. HSM keys are unaffected: their keymgmt is
# bound to ossl_hsm.
default_properties = ?provider=default

[provider_sect]
ossl_hsm = ossl_hsm_sect
default = default_sect

[ossl_hsm_sect]
# debian: relative paths resolve in /usr/lib/x86_64-linux-gnu/ossl-modules
module = libossl_hsm.so
activate = 1

[default_sect]
activate = 1
