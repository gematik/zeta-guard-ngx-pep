#!/usr/bin/env bash

set -e
set -u
set -o pipefail

export RUST_BACKTRACE=1

tests() {
	(
		set +e
		printf "!! tests\n\n"
		shopt -s nullglob
		# shellcheck disable=SC1091
		. /usr/local/share/cov-env

		cargo nextest run --workspace ${NEXTEST_FILTERSET:+--filterset "$NEXTEST_FILTERSET"}
		local result=$?

		if [[ -f prefix/test.log ]] && [[ $result -ne 0 ]]; then
			cat prefix/test.log || :
		fi

		# n.b.: --no-run is deprecated, but report doesn't support --workspace…
		cargo llvm-cov --no-run --workspace --remap-path-prefix
		cargo llvm-cov --no-run --workspace --remap-path-prefix --lcov --output-path coverage.lcov || :
		cargo llvm-cov clean --workspace || :
		exit $result
	)
	return $?
}

if [[ ${SKIP_TESTS:-0} -ne 1 ]]; then
	set +e
	tests
	test_result=$?
	printf "!! test result: %s\n\n" "$test_result"
	set -e
else
	test_result=0
fi

printf "!! build nginx module\n\n"
cargo clean-module --release

# -Zsbom: embed the SBOM from cargo's unit graph (exact) instead of `cargo
# metadata`, which lists dev-dep-activated optional deps (tarpc, client stack)
# as runtime although they are never linked.
# RUSTC_BOOTSTRAP=1 to allow -Z usage (config [env] can't satisfy cargo's own -Z gate)
RUSTC_BOOTSTRAP=1 cargo auditable build \
	--release -p ngx_pep --target-dir target/module \
	-Zsbom --config build.sbom=true

for pkg in ossl_hsm hsm_sim load_dispenser; do
	printf "!! build %q\n\n" "$pkg"
	# cargo-auditable injects at link time via RUSTC_WORKSPACE_WRAPPER, which cargo
	# does not fingerprint — a cached fresh artifact silently skips the wrapper.
	# Clean only the workspace members (dep cache stays warm) to guarantee relink.
	cargo clean --release -p "$pkg"
	RUSTC_BOOTSTRAP=1 cargo auditable build \
		--release -p "$pkg" \
		-Zsbom --config build.sbom=true
done

printf "!! clippy\n\n"
cargo clippy --workspace

printf "!! clippy json\n\n"
cargo clippy --workspace --message-format json >clippy.json

printf "!! write .pkg-version\n\n"
cargo metadata --format-version 1 | jq -r '.packages | map(select(.name == "ngx_pep")) | .[0].version' \
	>.pkg-version || :

printf "!! write ngx_pep.cdx.json\n\n"
cargo cyclonedx -f json -a

printf "!! mdbook\n\n"
mdbook build book

exit "$test_result"
